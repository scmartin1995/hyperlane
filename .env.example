# ---- Hyperlane local configuration (copy to .env) ----
# Everything runs on your machine. Data lives in ./data/hyperlane.db.
HYPERLANE_HOST=127.0.0.1
HYPERLANE_PORT=8787
HYPERLANE_SECRET=change-me-to-a-long-random-string
HYPERLANE_DB_PATH=./data/hyperlane.db

# ---- Claude (pick ONE provider) ----
# anthropic  : Anthropic API key (or `ant auth login` profile)
# bedrock    : Amazon Bedrock in your AWS account (uses your AWS credentials)
# claude-code: your Claude Code subscription login on this machine (uses the `claude` CLI)
HYPERLANE_LLM_PROVIDER=claude-code
HYPERLANE_LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...
# AWS_REGION=us-east-1
# HYPERLANE_BEDROCK_MODEL=anthropic.claude-opus-5-5

# ---- Slack (Socket Mode: no public URL needed) ----
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_DEFAULT_CHANNEL=#project-updates

# ---- Microsoft Teams (incoming webhook, outbound only) ----
# TEAMS_WEBHOOK_URL=https://...

# ---- Email intake (IMAP polling + SMTP replies) ----
# INTAKE_IMAP_HOST=imap.example.com
# INTAKE_IMAP_USER=requests@example.com
# INTAKE_IMAP_PASSWORD=...
# INTAKE_IMAP_FOLDER=INBOX
# INTAKE_SMTP_HOST=smtp.example.com
# INTAKE_SMTP_PORT=587
# INTAKE_SMTP_USER=requests@example.com
# INTAKE_SMTP_PASSWORD=...
# INTAKE_FROM_ADDRESS=requests@example.com
# INTAKE_POLL_SECONDS=60
